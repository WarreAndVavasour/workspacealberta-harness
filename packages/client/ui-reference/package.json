{
  "name": "@workspacealberta/wa-client-ui-reference",
  "description": "Unified Web @file and @session reference source",
  "version": "0.1.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-reference"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@workspacealberta/wa-api-remotes",
        "@workspacealberta/wa-api-session-controller",
        "@workspacealberta/wa-client-connection",
        "@workspacealberta/wa-client-locale",
        "@workspacealberta/wa-client-ui-input-trigger"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@workspacealberta/cordis": "workspace:^"
  },
  "devDependencies": {
    "@workspacealberta/wa-api-remotes": "workspace:^",
    "@workspacealberta/wa-api-session-controller": "workspace:^",
    "@workspacealberta/wa-client-connection": "workspace:^",
    "@workspacealberta/wa-client-locale": "workspace:^",
    "@workspacealberta/wa-client-test-runtime": "workspace:^",
    "@workspacealberta/wa-client-ui-input-trigger": "workspace:^",
    "@workspacealberta/wa-client-ui-primitives": "workspace:^",
    "@workspacealberta/wa-client-ui-slots": "workspace:^",
    "@workspacealberta/wa-file-reference": "workspace:^",
    "@workspacealberta/wa-session-reference": "workspace:^",
    "@workspacealberta/wa-typert-protocol": "workspace:^",
    "@workspacealberta/wa-util-workspace-path": "workspace:^",
    "@workspacealberta/cordis": "workspace:^"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
