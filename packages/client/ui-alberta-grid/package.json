{
  "name": "@workspacealberta/ui-alberta-grid",
  "description": "Alberta Grid v2 Wilke-honest AESO conversation view (CSD + pool price)",
  "version": "0.1.0-rc.8",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HarleyCoops/workspacealberta-harness.git",
    "directory": "packages/client/ui-alberta-grid"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@workspacealberta/wa-client-locale",
        "@workspacealberta/wa-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "dependencies": {
    "three": "^0.170.0"
  },
  "peerDependencies": {
    "@workspacealberta/wa-client-locale": "workspace:^",
    "@workspacealberta/wa-invariants": "workspace:^",
    "@workspacealberta/cordis": "workspace:^",
    "@workspacealberta/wa-client-ui-conversation": "workspace:^"
  },
  "devDependencies": {
    "@workspacealberta/cordis": "workspace:^",
    "@workspacealberta/wa-client-locale": "workspace:^",
    "@workspacealberta/wa-client-test-runtime": "workspace:^",
    "@workspacealberta/wa-client-ui-conversation": "workspace:^",
    "@workspacealberta/wa-client-ui-renderer": "workspace:^",
    "@workspacealberta/wa-client-ui-slots": "workspace:^",
    "@workspacealberta/wa-invariants": "workspace:^",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "@types/three": "^0.170.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
