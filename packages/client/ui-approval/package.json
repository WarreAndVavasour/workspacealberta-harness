{
  "name": "@workspacealberta/wa-client-ui-approval",
  "description": "Approval composer takeover over the scoped Remote Event waterfall",
  "version": "0.1.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-approval"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@workspacealberta/wa-api-remotes",
        "@workspacealberta/wa-api-session-controller",
        "@workspacealberta/wa-client-locale",
        "@workspacealberta/wa-client-ui-conversation",
        "@workspacealberta/wa-client-ui-renderer",
        "@workspacealberta/wa-client-ui-session"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@workspacealberta/cordis": "workspace:^"
  },
  "devDependencies": {
    "@workspacealberta/cordis": "workspace:^",
    "@workspacealberta/wa-api-remotes": "workspace:^",
    "@workspacealberta/wa-api-session-controller": "workspace:^",
    "@workspacealberta/wa-client-locale": "workspace:^",
    "@workspacealberta/wa-client-ui-conversation": "workspace:^",
    "@workspacealberta/wa-client-ui-primitives": "workspace:^",
    "@workspacealberta/wa-client-ui-renderer": "workspace:^",
    "@workspacealberta/wa-client-ui-session": "workspace:^",
    "@workspacealberta/wa-client-ui-slots": "workspace:^",
    "@workspacealberta/wa-llm": "workspace:^",
    "@workspacealberta/wa-session": "workspace:^",
    "@workspacealberta/wa-typert-protocol": "workspace:^",
    "@types/react": "~18.3.1",
    "react": "^18.2.0"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
