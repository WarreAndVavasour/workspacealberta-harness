{
  "name": "@workspacealberta/wa-client-ui-chat",
  "description": "Chat Conversation target, node definitions, renderers, and details surface",
  "version": "0.1.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-chat"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@workspacealberta/wa-api-session-controller",
        "@workspacealberta/wa-api-workspace-controller",
        "@workspacealberta/wa-client-locale",
        "@workspacealberta/wa-client-ui-conversation",
        "@workspacealberta/wa-client-ui-layout",
        "@workspacealberta/wa-client-ui-renderer",
        "@workspacealberta/wa-client-ui-session",
        "@workspacealberta/wa-client-ui-settings",
        "@workspacealberta/wa-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@workspacealberta/cordis": "workspace:^"
  },
  "devDependencies": {
    "@workspacealberta/cordis": "workspace:^",
    "@workspacealberta/wa-agent": "workspace:^",
    "@workspacealberta/wa-api-remotes": "workspace:^",
    "@workspacealberta/wa-api-session-controller": "workspace:^",
    "@workspacealberta/wa-api-workspace-controller": "workspace:^",
    "@workspacealberta/wa-attachment": "workspace:^",
    "@workspacealberta/wa-client-locale": "workspace:^",
    "@workspacealberta/wa-client-store": "workspace:^",
    "@workspacealberta/wa-client-ui-approval": "workspace:^",
    "@workspacealberta/wa-client-ui-conversation": "workspace:^",
    "@workspacealberta/wa-client-ui-layout": "workspace:^",
    "@workspacealberta/wa-client-ui-primitives": "workspace:^",
    "@workspacealberta/wa-client-ui-renderer": "workspace:^",
    "@workspacealberta/wa-client-ui-session": "workspace:^",
    "@workspacealberta/wa-client-ui-settings": "workspace:^",
    "@workspacealberta/wa-client-ui-slots": "workspace:^",
    "@workspacealberta/wa-client-ui-workspace": "workspace:^",
    "@workspacealberta/wa-commands": "workspace:^",
    "@workspacealberta/wa-compaction": "workspace:^",
    "@workspacealberta/wa-llm": "workspace:^",
    "@workspacealberta/wa-llm-retry": "workspace:^",
    "@workspacealberta/wa-session": "workspace:^",
    "@workspacealberta/wa-session-stats": "workspace:^",
    "@workspacealberta/wa-session-turn-outline": "workspace:^",
    "@workspacealberta/wa-token-meter": "workspace:^",
    "@workspacealberta/wa-tools": "workspace:^",
    "@workspacealberta/wa-util-workspace-path": "workspace:^",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@workspacealberta/wa-settings": "workspace:^"
  },
  "dependencies": {
    "@workspacealberta/schemastery": "workspace:^"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
