{
  "name": "@workspacealberta/wa-goal-round-driver",
  "description": "Race-fenced same-session goal-round driver",
  "version": "0.1.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/goal/goal-round-driver"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@workspacealberta/wa-agent": "workspace:^",
    "@workspacealberta/wa-goal": "workspace:^",
    "@workspacealberta/wa-invariants": "workspace:^",
    "@workspacealberta/wa-llm": "workspace:^",
    "@workspacealberta/wa-session": "workspace:^",
    "@workspacealberta/cordis": "workspace:^"
  },
  "devDependencies": {
    "@workspacealberta/wa-agent": "workspace:^",
    "@workspacealberta/wa-agent-loop": "workspace:^",
    "@workspacealberta/wa-agent-loop-testkit": "workspace:^",
    "@workspacealberta/wa-goal": "workspace:^",
    "@workspacealberta/wa-invariants": "workspace:^",
    "@workspacealberta/wa-llm": "workspace:^",
    "@workspacealberta/wa-session": "workspace:^",
    "@workspacealberta/wa-system-prompt": "workspace:^",
    "@workspacealberta/wa-tools": "workspace:^",
    "@workspacealberta/cordis": "workspace:^",
    "@workspacealberta/wa-session-projection": "workspace:^"
  }
}
