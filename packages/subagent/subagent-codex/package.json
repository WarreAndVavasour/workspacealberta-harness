{
  "name": "@workspacealberta/wa-subagent-codex",
  "description": "One-shot Codex subagent provider over the official app-server protocol",
  "version": "0.1.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/subagent/subagent-codex"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@workspacealberta/cordis": "workspace:^",
    "@workspacealberta/wa-llm": "workspace:^",
    "@workspacealberta/wa-session": "workspace:^",
    "@workspacealberta/wa-subagent": "workspace:^",
    "@workspacealberta/wa-subprocess": "workspace:^",
    "@workspacealberta/wa-timeout": "workspace:^"
  },
  "dependencies": {
    "@workspacealberta/wa-brand": "workspace:^",
    "@workspacealberta/wa-sdk-protocol": "workspace:^",
    "@workspacealberta/schemastery": "workspace:^",
    "@openai/codex": "0.149.1"
  },
  "devDependencies": {
    "@workspacealberta/cordis": "workspace:^",
    "@workspacealberta/cordis-plugin-loader": "workspace:^",
    "@workspacealberta/wa-agent": "workspace:^",
    "@workspacealberta/wa-app-boot": "workspace:^",
    "@workspacealberta/wa-llm": "workspace:^",
    "@workspacealberta/wa-loader-smoke": "workspace:^",
    "@workspacealberta/wa-session": "workspace:^",
    "@workspacealberta/wa-session-checkpoint-policy": "workspace:^",
    "@workspacealberta/wa-session-persistence-jsonl": "workspace:^",
    "@workspacealberta/wa-session-projection": "workspace:^",
    "@workspacealberta/wa-subagent": "workspace:^",
    "@workspacealberta/wa-subprocess": "workspace:^",
    "@workspacealberta/wa-subprocess-local": "workspace:^",
    "@workspacealberta/wa-timeout": "workspace:^",
    "@workspacealberta/wa-tool-jobs": "workspace:^",
    "@workspacealberta/wa-tool-subagent": "workspace:^",
    "@workspacealberta/wa-tools": "workspace:^"
  }
}
