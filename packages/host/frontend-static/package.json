{
  "name": "@workspacealberta/wa-host-frontend-static",
  "description": "SPA dist server for the Web shell: owns the webserver fallback seat, serving explicit index entries and static assets with traversal rejection and 404 misses",
  "version": "0.1.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/host/frontend-static"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@workspacealberta/wa-host-webserver": "workspace:^",
    "@workspacealberta/wa-client-connection": "workspace:^",
    "@workspacealberta/cordis": "workspace:^"
  },
  "dependencies": {
    "@workspacealberta/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@workspacealberta/cordis-plugin-loader": "workspace:^",
    "@workspacealberta/wa-client-connection": "workspace:^",
    "@workspacealberta/wa-credentials-local": "workspace:^",
    "@workspacealberta/wa-host-webserver": "workspace:^",
    "@workspacealberta/cordis": "workspace:^"
  }
}
