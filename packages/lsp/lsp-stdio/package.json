{
  "name": "@workspacealberta/wa-lsp-stdio",
  "description": "Generic stdio language-server provider for the DeepSeek Harness LSP capability seam (ctx.lsp) — spawns configured servers, translates JSON-RPC, and serves transient-open goToDefinition/findReferences/goToImplementation/hover queries in the host filesystem namespace",
  "version": "0.1.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/lsp/lsp-stdio"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@workspacealberta/cordis": "workspace:^",
    "@workspacealberta/wa-brand": "workspace:^",
    "@workspacealberta/wa-fs": "workspace:^",
    "@workspacealberta/wa-llm": "workspace:^",
    "@workspacealberta/wa-lsp": "workspace:^",
    "@workspacealberta/wa-subprocess": "workspace:^",
    "@workspacealberta/wa-timeout": "workspace:^"
  },
  "dependencies": {
    "@workspacealberta/wa-util-values": "workspace:^",
    "@workspacealberta/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@workspacealberta/cordis": "workspace:^",
    "@workspacealberta/wa-brand": "workspace:^",
    "@workspacealberta/wa-fs": "workspace:^",
    "@workspacealberta/wa-fs-local": "workspace:^",
    "@workspacealberta/wa-llm": "workspace:^",
    "@workspacealberta/wa-lsp": "workspace:^",
    "@workspacealberta/wa-subprocess": "workspace:^",
    "@workspacealberta/wa-subprocess-local": "workspace:^",
    "@workspacealberta/wa-timeout": "workspace:^",
    "typescript": "^6.0.3",
    "typescript-language-server": "^5.0.0"
  }
}
