{
  "name": "@workspacealberta/wa-api-session-controller",
  "description": "Session Remote commands, cold reads, and live control transport",
  "version": "0.1.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/api/session-controller"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./remote-events": {
      "types": "./lib/types/remote-events.d.ts",
      "default": "./lib/types/remote-events.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "external": [
        "@workspacealberta/wa-api-gateway/client"
      ],
      "inject": [
        "@workspacealberta/wa-api-gateway"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@workspacealberta/wa-brand": "workspace:^",
    "@workspacealberta/wa-deque": "workspace:^",
    "@workspacealberta/schemastery": "workspace:^",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@workspacealberta/cordis": "workspace:^",
    "@workspacealberta/wa-agent": "workspace:^",
    "@workspacealberta/wa-agent-default-model": "workspace:^",
    "@workspacealberta/wa-agent-presets": "workspace:^",
    "@workspacealberta/wa-api-gateway": "workspace:^",
    "@workspacealberta/wa-attachment": "workspace:^",
    "@workspacealberta/wa-client-connection": "workspace:^",
    "@workspacealberta/wa-file-reference": "workspace:^",
    "@workspacealberta/wa-jobs": "workspace:^",
    "@workspacealberta/wa-llm": "workspace:^",
    "@workspacealberta/wa-native-command": "workspace:^",
    "@workspacealberta/wa-scope": "workspace:^",
    "@workspacealberta/wa-session": "workspace:^",
    "@workspacealberta/wa-session-persistence": "workspace:^",
    "@workspacealberta/wa-session-projection": "workspace:^",
    "@workspacealberta/wa-session-projection-cache": "workspace:^",
    "@workspacealberta/wa-session-query": "workspace:^",
    "@workspacealberta/wa-session-title": "workspace:^",
    "@workspacealberta/wa-skill": "workspace:^",
    "@workspacealberta/wa-subagent": "workspace:^",
    "@workspacealberta/wa-typert-protocol": "workspace:^",
    "@workspacealberta/wa-typert-registry": "workspace:^",
    "@workspacealberta/wa-util-time": "workspace:^",
    "@workspacealberta/wa-util-workspace-path": "workspace:^",
    "@workspacealberta/wa-workspace": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@workspacealberta/wa-jobs": {
      "optional": true
    },
    "@workspacealberta/wa-session-persistence": {
      "optional": true
    },
    "@workspacealberta/wa-session-projection-cache": {
      "optional": true
    }
  },
  "devDependencies": {
    "@workspacealberta/cordis": "workspace:^",
    "@workspacealberta/wa-agent": "workspace:^",
    "@workspacealberta/wa-agent-default-model": "workspace:^",
    "@workspacealberta/wa-agent-presets": "workspace:^",
    "@workspacealberta/wa-api-gateway": "workspace:^",
    "@workspacealberta/wa-attachment": "workspace:^",
    "@workspacealberta/wa-client-connection": "workspace:^",
    "@workspacealberta/wa-client-store": "workspace:^",
    "@workspacealberta/wa-file-reference": "workspace:^",
    "@workspacealberta/wa-jobs": "workspace:^",
    "@workspacealberta/wa-llm": "workspace:^",
    "@workspacealberta/wa-native-command": "workspace:^",
    "@workspacealberta/wa-permission-presets": "workspace:^",
    "@workspacealberta/wa-scope": "workspace:^",
    "@workspacealberta/wa-session": "workspace:^",
    "@workspacealberta/wa-session-persistence": "workspace:^",
    "@workspacealberta/wa-session-projection": "workspace:^",
    "@workspacealberta/wa-session-projection-cache": "workspace:^",
    "@workspacealberta/wa-session-query": "workspace:^",
    "@workspacealberta/wa-session-title": "workspace:^",
    "@workspacealberta/wa-skill": "workspace:^",
    "@workspacealberta/wa-storage": "workspace:^",
    "@workspacealberta/wa-storage-domain": "workspace:^",
    "@workspacealberta/wa-storage-json": "workspace:^",
    "@workspacealberta/wa-subagent": "workspace:^",
    "@workspacealberta/wa-typert-protocol": "workspace:^",
    "@workspacealberta/wa-typert-registry": "workspace:^",
    "@workspacealberta/wa-util-crypto": "workspace:^",
    "@workspacealberta/wa-util-time": "workspace:^",
    "@workspacealberta/wa-util-workspace-path": "workspace:^",
    "@workspacealberta/wa-workspace": "workspace:^"
  }
}
