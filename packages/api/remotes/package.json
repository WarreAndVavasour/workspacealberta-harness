{
  "name": "@workspacealberta/wa-api-remotes",
  "description": "Remote BFF assembly for application-selected Host capabilities",
  "version": "0.1.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/api/remotes"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@workspacealberta/wa-api-gateway"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@workspacealberta/wa-deque": "workspace:^",
    "@workspacealberta/wa-session": "workspace:^",
    "@workspacealberta/wa-util-values": "workspace:^"
  },
  "peerDependencies": {
    "@workspacealberta/cordis": "workspace:^",
    "@workspacealberta/wa-scope": "workspace:^"
  },
  "devDependencies": {
    "@workspacealberta/cordis": "workspace:^",
    "@workspacealberta/wa-agent-presets": "workspace:^",
    "@workspacealberta/wa-api-gateway": "workspace:^",
    "@workspacealberta/wa-api-settings-controller": "workspace:^",
    "@workspacealberta/wa-api-workspace-controller": "workspace:^",
    "@workspacealberta/wa-commands": "workspace:^",
    "@workspacealberta/wa-cordis-host-runner": "workspace:^",
    "@workspacealberta/wa-credentials": "workspace:^",
    "@workspacealberta/wa-file-reference": "workspace:^",
    "@workspacealberta/wa-goal": "workspace:^",
    "@workspacealberta/wa-host-plugin-inventory": "workspace:^",
    "@workspacealberta/wa-llm": "workspace:^",
    "@workspacealberta/wa-message-feedback": "workspace:^",
    "@workspacealberta/wa-session-reference": "workspace:^",
    "@workspacealberta/wa-settings": "workspace:^",
    "@workspacealberta/wa-subagent": "workspace:^",
    "@workspacealberta/wa-user-approval": "workspace:^",
    "@workspacealberta/wa-user-questions": "workspace:^",
    "@workspacealberta/wa-client-connection": "workspace:^",
    "@workspacealberta/wa-typert-protocol": "workspace:^",
    "@workspacealberta/wa-scope": "workspace:^",
    "@workspacealberta/wa-api-session-controller": "workspace:^"
  }
}
