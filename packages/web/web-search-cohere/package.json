{
  "name": "@workspacealberta/web-search-cohere",
  "description": "Cohere-backed search provider for the web capability seam (ctx.web): anonymous DuckDuckGo acquisition synthesized through a Cohere v2 native tool-use loop",
  "version": "0.1.0-rc.8",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/web/web-search-cohere"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@workspacealberta/wa-agent": "workspace:^",
    "@workspacealberta/wa-credentials": "workspace:^",
    "@workspacealberta/wa-launch-environment": "workspace:^",
    "@workspacealberta/wa-invariants": "workspace:^",
    "@workspacealberta/wa-session": "workspace:^",
    "@workspacealberta/wa-web": "workspace:^",
    "@workspacealberta/cordis": "workspace:^",
    "@workspacealberta/wa-settings": "workspace:^"
  },
  "dependencies": {
    "@workspacealberta/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@workspacealberta/wa-agent": "workspace:^",
    "@workspacealberta/wa-credentials": "workspace:^",
    "@workspacealberta/wa-launch-environment": "workspace:^",
    "@workspacealberta/wa-invariants": "workspace:^",
    "@workspacealberta/wa-session": "workspace:^",
    "@workspacealberta/wa-web": "workspace:^",
    "@workspacealberta/cordis": "workspace:^",
    "@workspacealberta/wa-settings": "workspace:^"
  }
}
