{
  "name": "@workspacealberta/wa-headless",
  "description": "The dsh one-shot bundle: a direct core Agent/Session runner over dsh-base with no Host, HTTP, or browser layer",
  "version": "0.1.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/bundle/headless"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./startup": {
      "types": "./lib/types/startup.d.ts",
      "default": "./lib/startup.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/startup.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@workspacealberta/wa-brand": "workspace:^",
    "@workspacealberta/wa-cmdline": "workspace:^",
    "@workspacealberta/wa-code-runtime-worker-thread": "workspace:^",
    "@workspacealberta/wa-util-values": "workspace:^",
    "@workspacealberta/schemastery": "workspace:^",
    "commander": "^15.0.0"
  },
  "peerDependencies": {
    "@workspacealberta/cordis": "workspace:^",
    "@workspacealberta/cordis-plugin-loader": "workspace:^",
    "@workspacealberta/wa-agent": "workspace:^",
    "@workspacealberta/wa-agent-default-model": "workspace:^",
    "@workspacealberta/wa-llm": "workspace:^",
    "@workspacealberta/wa-session": "workspace:^"
  },
  "devDependencies": {
    "@workspacealberta/cordis": "workspace:^",
    "@workspacealberta/cordis-plugin-loader": "workspace:^",
    "@workspacealberta/wa-agent": "workspace:^",
    "@workspacealberta/wa-agent-default-model": "workspace:^",
    "@workspacealberta/wa-llm": "workspace:^",
    "@workspacealberta/wa-session": "workspace:^"
  }
}
