{
  "name": "@workspacealberta/wa-acp",
  "description": "Automation-only Agent Client Protocol server for driving DeepSeek Harness agents over JSON-RPC stdio",
  "version": "0.1.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/acp/acp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@workspacealberta/wa-brand": "workspace:^",
    "@workspacealberta/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@workspacealberta/cordis": "workspace:^",
    "@workspacealberta/wa-agent": "workspace:^",
    "@workspacealberta/wa-attachment": "workspace:^",
    "@workspacealberta/wa-llm": "workspace:^",
    "@workspacealberta/wa-mcp-client": "workspace:^",
    "@workspacealberta/wa-session": "workspace:^",
    "@workspacealberta/wa-session-persistence": "workspace:^",
    "@workspacealberta/wa-token-meter": "workspace:^",
    "@workspacealberta/wa-user-approval": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@workspacealberta/wa-token-meter": {
      "optional": true
    }
  },
  "devDependencies": {
    "@workspacealberta/cordis": "workspace:^",
    "@workspacealberta/wa-agent": "workspace:^",
    "@workspacealberta/wa-agent-loop": "workspace:^",
    "@workspacealberta/wa-agent-loop-testkit": "workspace:^",
    "@workspacealberta/wa-attachment": "workspace:^",
    "@workspacealberta/wa-llm": "workspace:^",
    "@workspacealberta/wa-mcp-client": "workspace:^",
    "@workspacealberta/wa-session": "workspace:^",
    "@workspacealberta/wa-session-persistence": "workspace:^",
    "@workspacealberta/wa-session-persistence-jsonl": "workspace:^",
    "@workspacealberta/wa-session-projection": "workspace:^",
    "@workspacealberta/wa-token-meter": "workspace:^",
    "@workspacealberta/wa-tools": "workspace:^",
    "@workspacealberta/wa-user-approval": "workspace:^"
  }
}
