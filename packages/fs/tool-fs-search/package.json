{
  "name": "@workspacealberta/wa-tool-fs-search",
  "description": "Model-facing filesystem discovery tools (glob, grep) backed by the packaged ripgrep binary (@vscode/ripgrep)",
  "version": "0.1.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/fs/tool-fs-search"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@vscode/ripgrep": "^1.18.0",
    "@workspacealberta/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@workspacealberta/wa-llm": "workspace:^",
    "@workspacealberta/wa-output-retention": "workspace:^",
    "@workspacealberta/wa-session": "workspace:^",
    "@workspacealberta/wa-spill": "workspace:^",
    "@workspacealberta/wa-subprocess": "workspace:^",
    "@workspacealberta/wa-system-prompt": "workspace:^",
    "@workspacealberta/wa-timeout": "workspace:^",
    "@workspacealberta/wa-tools": "workspace:^",
    "@workspacealberta/cordis": "workspace:^"
  },
  "devDependencies": {
    "@workspacealberta/wa-agent": "workspace:^",
    "@workspacealberta/wa-subprocess": "workspace:^",
    "@workspacealberta/wa-subprocess-local": "workspace:^",
    "@workspacealberta/wa-llm": "workspace:^",
    "@workspacealberta/wa-output-retention": "workspace:^",
    "@workspacealberta/wa-session": "workspace:^",
    "@workspacealberta/wa-spill": "workspace:^",
    "@workspacealberta/wa-system-prompt": "workspace:^",
    "@workspacealberta/wa-timeout": "workspace:^",
    "@workspacealberta/wa-tools": "workspace:^",
    "@workspacealberta/cordis": "workspace:^"
  }
}
